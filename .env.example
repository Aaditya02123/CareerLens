# Copy this file to .env only when a feature requires local configuration.
# Do not commit .env or real credentials.

# Runtime
CAREERLENS_ENV=development

# Backend / frontend connection (planned)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database (planned; choose the final local setup before enabling it)
DATABASE_URL=

# Authentication. Generate a high-entropy value for every non-development
# environment; the API refuses the development fallback outside development.
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# External integrations (planned; configure only when their adapters are introduced)
PLUGS_API_BASE_URL=
OUTREACH_ASSISTANT_PATH=

# Local Ollama provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
# Set this in the environment used to launch `ollama serve`.
OLLAMA_NUM_PARALLEL=1

# Other AI providers (configure only when their adapters are introduced)
LLM_API_KEY=
